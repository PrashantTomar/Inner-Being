views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "Inner Being/Research/Home/Speculative streams"
    order:
      - file.name
      - file.tags
      - file.links
      - file.ctime
      - file.basename
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 482
      file.basename: 412
